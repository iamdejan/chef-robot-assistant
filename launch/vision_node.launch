<launch>
  <!-- Keep camera fixes overridable here because the target robot camera may
       not need the same channel handling as this development VM. -->
  <arg name="video_device" default="/dev/video0" />
  <arg name="image_width" default="640" />
  <arg name="image_height" default="480" />
  <arg name="fps" default="30.0" />
  <arg name="camera_frame_id" default="usb_cam" />
  <arg name="swap_rb_channels" default="true" />
  <arg name="openai_vision_model" default="gpt-5.1" />
  <arg name="openai_vision_api_timeout_sec" default="30.0" />
  <arg name="openai_vision_image_detail" default="high" />

  <rosparam command="load" file="$(find chef_robot_assistant)/config/robot_config.yaml" />

  <!-- The normal launch should behave like the real runtime path: camera node
       first, then vision node consuming /usb_cam/image_raw. -->
  <param name="/chef_robot_assistant/camera_topic" value="/usb_cam/image_raw" />

  <node
    name="webcam_node"
    pkg="chef_robot_assistant"
    type="webcam_node.py"
    output="screen"
  >
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="$(arg image_width)" />
    <param name="image_height" value="$(arg image_height)" />
    <param name="fps" value="$(arg fps)" />
    <param name="camera_frame_id" value="$(arg camera_frame_id)" />
    <param name="swap_rb_channels" value="$(arg swap_rb_channels)" />
  </node>

  <node
    pkg="chef_robot_assistant"
    type="vision_node.py"
    name="vision_node"
    output="screen"
  >
    <param name="/chef_robot_assistant/openai_vision_model" value="$(arg openai_vision_model)" />
    <param name="/chef_robot_assistant/openai_vision_api_timeout_sec" value="$(arg openai_vision_api_timeout_sec)" />
    <param name="/chef_robot_assistant/openai_vision_image_detail" value="$(arg openai_vision_image_detail)" />
  </node>
</launch>
