<launch>
  <!-- This launch keeps aggressive debugging knobs and preview support that we
       do not want in the normal runtime launch. -->
  <arg name="video_device" default="/dev/video0" />
  <arg name="image_width" default="640" />
  <arg name="image_height" default="480" />
  <arg name="fps" default="30.0" />
  <arg name="camera_frame_id" default="usb_cam" />
  <arg name="preview_topic" default="/usb_cam/image_raw" />
  <arg name="swap_rb_channels" default="true" />
  <arg name="confidence_threshold" default="0.25" />
  <arg name="capture_duration_sec" default="2.0" />
  <arg name="sample_frame_count" default="4" />
  <arg name="min_frame_hits" default="1" />

  <rosparam command="load" file="$(find chef_robot_assistant)/config/robot_config.yaml" />

  <!-- Test launch overrides production defaults so live iteration is faster
       while we debug hosted workflow latency and camera issues. -->
  <param name="/chef_robot_assistant/camera_topic" value="/usb_cam/image_raw" />
  <param
    name="/chef_robot_assistant/detection_confidence_threshold"
    value="$(arg confidence_threshold)"
  />
  <param
    name="/chef_robot_assistant/capture_duration_sec"
    value="$(arg capture_duration_sec)"
  />
  <param
    name="/chef_robot_assistant/vision_sample_frame_count"
    value="$(arg sample_frame_count)"
  />
  <param
    name="/chef_robot_assistant/vision_min_frame_hits"
    value="$(arg min_frame_hits)"
  />

  <node
    name="webcam_node"
    pkg="chef_robot_assistant"
    type="webcam_node.py"
    output="screen"
  >
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="$(arg image_width)" />
    <param name="image_height" value="$(arg image_height)" />
    <param name="fps" value="$(arg fps)" />
    <param name="camera_frame_id" value="$(arg camera_frame_id)" />
    <param name="swap_rb_channels" value="$(arg swap_rb_channels)" />
  </node>

  <node
    pkg="chef_robot_assistant"
    type="vision_node.py"
    name="vision_node"
    output="screen"
  />

  <node
    name="camera_preview"
    pkg="image_view"
    type="image_view"
    output="screen"
  >
    <!-- Keep the preview window here only; the normal launch should stay
         closer to headless robot operation. -->
    <remap from="image" to="$(arg preview_topic)" />
    <param name="autosize" value="true" />
  </node>
</launch>
